# Copie para .env no servidor (cp .env.production.example .env) e preencha.
# Nunca faça commit do .env.

# Domínio apontando para o IP do servidor (registro DNS A/AAAA).
DOMAIN=homehub.seudominio.com

# Banco de dados. Gere uma senha forte: openssl rand -base64 32
POSTGRES_DB=homehub
POSTGRES_USER=homehub
POSTGRES_PASSWORD=

# Primeiro usuário (só é criado quando ainda não existe nenhum usuário).
# Depois do primeiro login, apague ADMIN_PASSWORD deste arquivo.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Duração da sessão de login, em dias.
SESSION_TTL_DAYS=30
