# Desenvolvimento local. Para produção (Vercel + Neon), veja DEPLOY.md.

# API
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homehub

# Primeiro usuário, criado na inicialização quando a tabela de usuários está vazia.
ADMIN_EMAIL=admin@homehub.local
ADMIN_PASSWORD=troque-esta-senha

# PostgreSQL
POSTGRES_DB=homehub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
